# Configuração local: preencha apenas no seu computador ou no serviço de hospedagem.
# Nunca versione valores reais nem exponha a chave service role no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-publica-anon
SUPABASE_SERVICE_ROLE_KEY=chave-privada-apenas-no-servidor
SUPABASE_ADMIN_EMAIL=seu-email-de-administrador

# Necessário apenas se usar o banco MySQL em vez do Supabase.
DATABASE_URL=

# Opcional: emissão de recibos por e-mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RECEIPT_ISSUER_CPF=
